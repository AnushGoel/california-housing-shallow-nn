# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud > your app > Settings > Secrets. Never commit the real file.

[storage]
# "local" = the server's disk (fine locally; wiped whenever Streamlit Community Cloud restarts the app)
# "s3"    = any S3-compatible bucket: AWS S3, Cloudflare R2, Backblaze B2 or MinIO
user_backend = "s3"            # saved scenarios and game scores
artifacts_backend = "local"    # "local" reads artifacts/ from the repository; "s3" reads them from the bucket

bucket = "your-bucket-name"
prefix = "california-housing-nn"
region = "auto"                # e.g. "us-east-1" on AWS; "auto" on Cloudflare R2
endpoint_url = ""              # empty on AWS; "https://<account-id>.r2.cloudflarestorage.com" on Cloudflare R2
aws_access_key_id = "replace-me"
aws_secret_access_key = "replace-me"
